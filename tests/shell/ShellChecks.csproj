<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MailCleaner</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../shell/Messages.cs" />
    <Compile Include="../../shell/Texts.cs" />
    <Compile Include="../../shell/Errors.cs" />
    <Compile Include="../../shell/LoopbackHttp.cs" />
    <Compile Include="../../shell/SiteServer.cs" />
    <Compile Include="../../shell/Desktop.cs" />
    <Compile Include="../../shell/SignIn.cs" />
    <EmbeddedResource Include="../../app/**/*" LogicalName="site.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
